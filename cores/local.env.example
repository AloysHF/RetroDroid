# Point at local checkouts (e.g. the adaptation worktrees) instead of cloning
# from GitHub. Copy to cores/local.env, which is not tracked.
#
# RETRODROID_NATIVE32_SOURCE=/path/to/Native32Emu
# RETRODROID_COOLBAR_SOURCE=/path/to/CoolbarEmu
# RETRODROID_DINGOO_SOURCE=/path/to/DingooEmu
# RETRODROID_HYPERSCAN_SOURCE=/path/to/HyperScanEmu
# RETRODROID_LAVAX_SOURCE=/path/to/LavaXEmu
# RETRODROID_PLAYDIA_SOURCE=/path/to/PlaydiaEmu
# RETRODROID_SPMP8000_SOURCE=/path/to/SPMP8000Emu
# RETRODROID_WQX_SOURCE=/path/to/WQXEmu
# RETRODROID_BBK_SOURCE=/path/to/BBKEmu
